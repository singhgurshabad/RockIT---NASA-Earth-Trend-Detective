# Copy to .env only if you need to change a default. Nothing here is secret.
# The API reads plain environment variables, so either export them in your shell
# or start uvicorn with:  uvicorn main:app --env-file .env

# Web origins allowed to call the API (comma-separated, no trailing slash).
# Add your deployed frontend URL here when the API runs on AWS.
ROCKIT_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional. Path to the reviewed run's robustness.csv. Default: ../analysis/results/robustness.csv
# ROCKIT_ROBUSTNESS_CSV=/absolute/path/to/robustness.csv
